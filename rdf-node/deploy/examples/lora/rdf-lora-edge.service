# Contoh: jembatan MQTT <-> LoRa serial di Raspberry (lihat docs/LORA_SERIAL.md). Tidak dipasang otomatis.
# Port LoRa (CH340 bekas T900) diakses lewat /dev/t900 dari 99-t900.rules; t900-ppp harus mati.
[Unit]
Description=RDF Node LoRa serial bridge (edge)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=exec
User=rdf-edge
Group=rdf-edge
SupplementaryGroups=dialout
ExecStart=/usr/bin/python3 /opt/rdf-node/current/run.py lora-bridge --role edge --device /dev/t900 --baud 115200 --node-id uav-01 --mqtt-host 127.0.0.1 --mqtt-port 1883
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
