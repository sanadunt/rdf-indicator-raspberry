[Unit]
Description=RDF Node restricted local control helper
After=local-fs.target

[Service]
Type=exec
User=root
ExecStart=/usr/bin/python3 /opt/rdf-node/current/run.py helper --policy /etc/rdf-node/helper.yaml
Restart=on-failure
RestartSec=3
StateDirectory=rdf-node-control
StateDirectoryMode=0700
RuntimeDirectory=rdf-node-control
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077

[Install]
WantedBy=multi-user.target
