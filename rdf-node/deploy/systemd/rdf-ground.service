[Unit]
Description=RDF Ground companion receiver and receipt service
After=network.target

[Service]
Type=exec
User=rdf-ground
Group=rdf-ground
WorkingDirectory=/opt/rdf-node/current
ExecStart=/usr/bin/python3 /opt/rdf-node/current/run.py ground --config /etc/rdf-ground/config.yaml
Restart=on-failure
RestartSec=3
StateDirectory=rdf-ground
StateDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rdf-ground
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027

[Install]
WantedBy=multi-user.target
