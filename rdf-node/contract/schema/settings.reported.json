{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanadunt/rdf-indicator-raspberry/rdf-node/contract/schema/settings.reported.json",
  "title": "settings/reported",
  "description": "Jawaban config.get: teks mentah settings.json native. Field tambahan boleh ada dan harus diabaikan consumer.",
  "x-topic": "settings/reported",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "sid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "Session id; berubah setiap agent start."
    },
    "boot": {
      "type": "string",
      "pattern": "^[0-9A-Za-z-]{8,64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "rev": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4294967295
    },
    "t": {
      "type": "integer",
      "minimum": 1000000000000,
      "maximum": 9999999999999,
      "description": "Unix epoch milidetik."
    },
    "settings_json": {
      "type": "string",
      "maxLength": 8192
    }
  },
  "required": [
    "v",
    "sid",
    "boot",
    "id",
    "rev",
    "t",
    "settings_json"
  ],
  "additionalProperties": true
}
