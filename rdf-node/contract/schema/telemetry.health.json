{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanadunt/rdf-indicator-raspberry/rdf-node/contract/schema/telemetry.health.json",
  "title": "telemetry/health",
  "description": "Heartbeat 1/s. Field tambahan boleh ada dan harus diabaikan consumer. Sejak kontrak 1.6 health bisa membawa field nav opsional (hdg/hs untuk kompas, gs/fix/sat untuk GPS, lat/lon/alt/sog/cog untuk posisi); field itu hanya ada bila sensornya dikonfigurasi.",
  "x-topic": "telemetry/health",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "sid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "Session id; berubah setiap agent start."
    },
    "q": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "t": {
      "type": "integer",
      "minimum": 1000000000000,
      "maximum": 9999999999999,
      "description": "Unix epoch milidetik."
    },
    "run": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        255
      ]
    },
    "daq": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "drop": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "age": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "temp": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -100,
      "maximum": 200
    },
    "clk": {
      "enum": [
        0,
        1
      ]
    },
    "rev": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4294967295
    },
    "why": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_:]{1,64}$"
      },
      "maxItems": 32,
      "description": "Alasan DoA belum live; kosong saat live."
    },
    "hdg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 359.9,
      "description": "Heading kompas derajat (0 = utara magnetik + nav.compass.offset_deg, searah jarum jam), 0.1 derajat. null bila hs bukan OK. Tidak ada bila kompas tidak dikonfigurasi."
    },
    "hs": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{1,32}$",
      "description": "State kompas: OK, STALE, NO_REPLY, BAD_FRAME, NO_DEVICE, STARTING, ERROR."
    },
    "gs": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{1,32}$",
      "description": "State GPS: FIX, NO_FIX, NO_DATA, BAD_DATA, NO_DEVICE, STARTING, ERROR."
    },
    "fix": {
      "enum": [
        0,
        2,
        3
      ],
      "description": "0 tanpa fix, 2 fix 2D, 3 fix 3D."
    },
    "sat": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 255,
      "description": "Satelit yang dipakai (GGA)."
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Derajat WGS84, 5 desimal. Hanya bila fix dan nav.gps.publish_position aktif."
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "Derajat WGS84, 5 desimal. Hanya bersama lat."
    },
    "alt": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1000,
      "maximum": 100000,
      "description": "Ketinggian MSL meter, fix 3D saja."
    },
    "sog": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000,
      "description": "Kecepatan di atas tanah m/s, 0.1."
    },
    "cog": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 360,
      "description": "Arah gerak di atas tanah, derajat true."
    }
  },
  "required": [
    "v",
    "sid",
    "q",
    "t",
    "run",
    "daq",
    "drop",
    "age",
    "temp",
    "clk",
    "rev",
    "why"
  ],
  "additionalProperties": true
}
