{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanadunt/rdf-indicator-raspberry/rdf-node/contract/schema/telemetry.doa.json",
  "title": "telemetry/doa",
  "description": "Satu PUBLISH per sampel DoA baru, berlabel `ok`. Lihat PROTOCOL.md \"DoA compact\". Field tambahan boleh ada dan harus diabaikan consumer.",
  "x-topic": "telemetry/doa",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "sid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "Session id; berubah setiap agent start."
    },
    "q": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "t": {
      "type": "integer",
      "minimum": 1000000000000,
      "maximum": 9999999999999,
      "description": "Unix epoch milidetik."
    },
    "f": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "a": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "c": {
      "type": "number",
      "minimum": -327.67,
      "maximum": 327.67
    },
    "p": {
      "type": "number",
      "minimum": -1000000.0,
      "maximum": 1000000.0
    },
    "rev": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4294967295
    },
    "ok": {
      "enum": [
        0,
        1
      ]
    },
    "clk": {
      "enum": [
        0,
        1
      ]
    },
    "age": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "reason": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_:]{1,64}$"
      },
      "maxItems": 32
    },
    "trust": {
      "const": "UNVERIFIED"
    },
    "angle_reference": {
      "const": "RAW"
    },
    "validation_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "SOURCE_UNVERIFIED",
          "ANGLE_UNVERIFIED"
        ]
      },
      "minItems": 1,
      "maxItems": 2
    },
    "h": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 360,
      "description": "Edge 1.10+ (nav aktif): heading referensi array (DoA 0°) saat kirim, derajat searah jarum jam dari utara; null bila tidak ada sumber heading."
    },
    "hsrc": {
      "enum": [
        "C",
        "G",
        "H",
        null
      ],
      "description": "Sumber h: C kompas (+offset_deg), G course GPS saat bergerak (+travel_offset_deg), H course GPS terakhir yang ditahan."
    },
    "b": {
      "type": "number",
      "minimum": 0,
      "maximum": 360,
      "description": "Bearing ke pemancar dari utara searah jarum jam: (h - a) mod 360 dengan capabilities.angle theta_mirror (a = theta_0, berlawanan jarum jam), (h + a) mod 360 dengan csv_native; hanya bila ok=1 dan h ada."
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Posisi saat sampel diambil (5 desimal); hanya dengan fix GPS dan nav.gps.publish_position."
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    }
  },
  "required": [
    "v",
    "sid",
    "q",
    "t",
    "f",
    "a",
    "c",
    "p",
    "rev",
    "ok",
    "clk",
    "age",
    "reason"
  ],
  "additionalProperties": true,
  "anyOf": [
    {
      "properties": {
        "ok": {
          "const": 1
        },
        "reason": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "ok": {
          "const": 0
        }
      },
      "required": [
        "trust",
        "angle_reference"
      ]
    }
  ],
  "dependentRequired": {
    "b": [
      "h"
    ],
    "lat": [
      "lon"
    ],
    "lon": [
      "lat"
    ]
  }
}
