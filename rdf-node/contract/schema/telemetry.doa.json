{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanadunt/rdf-indicator-raspberry/rdf-node/contract/schema/telemetry.doa.json",
  "title": "telemetry/doa",
  "description": "Satu PUBLISH per sampel DoA baru, berlabel `ok`. Lihat PROTOCOL.md \"DoA compact\". Field tambahan boleh ada dan harus diabaikan consumer.",
  "x-topic": "telemetry/doa",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "sid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "Session id; berubah setiap agent start."
    },
    "q": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "t": {
      "type": "integer",
      "minimum": 1000000000000,
      "maximum": 9999999999999,
      "description": "Unix epoch milidetik."
    },
    "f": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "a": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "c": {
      "type": "number",
      "minimum": -327.67,
      "maximum": 327.67
    },
    "p": {
      "type": "number",
      "minimum": -1000000.0,
      "maximum": 1000000.0
    },
    "rev": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4294967295
    },
    "ok": {
      "enum": [
        0,
        1
      ]
    },
    "clk": {
      "enum": [
        0,
        1
      ]
    },
    "age": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "reason": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_:]{1,64}$"
      },
      "maxItems": 32
    },
    "trust": {
      "const": "UNVERIFIED"
    },
    "angle_reference": {
      "const": "RAW"
    },
    "validation_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "SOURCE_UNVERIFIED",
          "ANGLE_UNVERIFIED"
        ]
      },
      "minItems": 1,
      "maxItems": 2
    }
  },
  "required": [
    "v",
    "sid",
    "q",
    "t",
    "f",
    "a",
    "c",
    "p",
    "rev",
    "ok",
    "clk",
    "age",
    "reason"
  ],
  "additionalProperties": true,
  "anyOf": [
    {
      "properties": {
        "ok": {
          "const": 1
        },
        "reason": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "ok": {
          "const": 0
        }
      },
      "required": [
        "trust",
        "angle_reference"
      ]
    }
  ]
}
