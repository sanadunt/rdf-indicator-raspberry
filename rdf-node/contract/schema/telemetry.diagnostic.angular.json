{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanadunt/rdf-indicator-raspberry/rdf-node/contract/schema/telemetry.diagnostic.angular.json",
  "title": "telemetry/diagnostic/angular",
  "description": "Kandidat 360 nilai lewat Control saat Bulk tidak bisa mengirim; selalu UNVERIFIED di Ground. Field tambahan boleh ada dan harus diabaikan consumer.",
  "x-topic": "telemetry/diagnostic/angular",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "encoding": {
      "const": "json"
    },
    "sid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "Session id; berubah setiap agent start."
    },
    "q": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 1000000000000,
      "maximum": 9999999999999,
      "description": "Unix epoch milidetik."
    },
    "frequency_hz": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4294967295
    },
    "vfo": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "convention": {
      "const": 1
    },
    "flags": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "raw_doa_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "confidence_native_db": {
      "type": "number",
      "minimum": -327.67,
      "maximum": 327.67
    },
    "values": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -100000000.0,
        "maximum": 100000000.0
      },
      "minItems": 360,
      "maxItems": 360
    }
  },
  "required": [
    "v",
    "encoding",
    "sid",
    "q",
    "timestamp_ms",
    "frequency_hz",
    "revision",
    "vfo",
    "convention",
    "flags",
    "raw_doa_deg",
    "confidence_native_db",
    "values"
  ],
  "additionalProperties": true
}
