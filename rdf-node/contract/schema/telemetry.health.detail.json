{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanadunt/rdf-indicator-raspberry/rdf-node/contract/schema/telemetry.health.detail.json",
  "title": "telemetry/health/detail",
  "description": "Detail host dan link tiap 10 s. Field tambahan boleh ada dan harus diabaikan consumer.",
  "x-topic": "telemetry/health/detail",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "sid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "Session id; berubah setiap agent start."
    },
    "t": {
      "type": "integer",
      "minimum": 1000000000000,
      "maximum": 9999999999999,
      "description": "Unix epoch milidetik."
    },
    "usb": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 64
    },
    "sync": {
      "type": "array",
      "items": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "minItems": 3,
      "maxItems": 3
    },
    "cpu": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "mem": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "disk_free": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "throt": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "uv": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "tx": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000.0
    },
    "rx": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000.0
    },
    "adrop": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "parse": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "ppp": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "peer": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "ppp_svc": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "ppp_restarts": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "perr": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 16
    },
    "crej": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "required": [
    "v",
    "sid",
    "t",
    "sync",
    "adrop",
    "parse",
    "perr",
    "crej"
  ],
  "additionalProperties": true
}
